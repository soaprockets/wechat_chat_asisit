# Unified domestic LLM configuration
# Works with any OpenAI-compatible API: Volcano Ark, DeepSeek, Zhipu, Qwen, Moonshot, Baichuan, etc.
# Just set BASE_URL + API_KEY + MODEL for the provider/agent-plan/token-plan you want to use.
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
LLM_API_KEY=your-api-key-here
LLM_MODEL=ark-code-latest
LLM_API_TYPE=openai  # openai | anthropic

# Optional fallback LLM (same unified schema)
# FALLBACK_LLM_BASE_URL=https://api.deepseek.com/v1
# FALLBACK_LLM_API_KEY=sk-...
# FALLBACK_LLM_MODEL=deepseek-chat
# FALLBACK_LLM_API_TYPE=openai

# Optional safety LLM (falls back to main LLM if omitted)
# SAFETY_LLM_BASE_URL=https://api.deepseek.com/v1
# SAFETY_LLM_API_KEY=sk-...
# SAFETY_LLM_MODEL=deepseek-chat
# SAFETY_LLM_API_TYPE=openai

# Embeddings (OpenAI-compatible, optional)
# EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# EMBEDDING_API_KEY=...
EMBEDDING_MODEL=embedding-2

# Memory
REDIS_URL=redis://localhost:6379/0
CHROMA_DB_PATH=./data/chroma
PROFILE_STORE_TYPE=json
PROFILE_STORE_PATH=./data/profiles

# Safety
SAFETY_KEYWORDS=转账,密码,验证码,身份证,银行卡,地址

# Gateway: mock | vision
WECHAT_GATEWAY=mock

# Vision gateway settings (only used when WECHAT_GATEWAY=vision)
VISION_POLL_INTERVAL=2.0
VISION_WINDOW_TITLE_REGEX=WeChat|微信
VISION_TARGETS=[{"friend_name":"好友昵称","chat_id":"friend_001"}]
VISION_SEND_ENABLED=true
VISION_DRY_RUN=false
VISION_CHANGE_THRESHOLD=5
VISION_IMAGE_MAX_WIDTH=1280
VISION_WINDOW_WAIT_TIMEOUT=30.0

# Logging
LOG_LEVEL=INFO
